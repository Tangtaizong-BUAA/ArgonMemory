# OmniMemEval's answer and judge configuration.
#
# Copy this file outside the repository, replace only the two key placeholders,
# and keep the private copy untracked. Argon's MCP endpoint and KB root are set
# by the benchmark launcher, not stored beside credentials.

TOPK=20
LLM_WORKERS=10

# Keep these exact model snapshots for direct comparison with OmniMemEval's
# published reproduced-results matrix.
ANSWER_MODEL="gpt-4.1-mini-2025-04-14"
ANSWER_BASE_URL="https://api.openai.com/v1"
ANSWER_API_KEY="<YOUR_ANSWER_API_KEY>"

EVAL_MODEL="gpt-4o-mini-2024-07-18"
EVAL_BASE_URL="https://api.openai.com/v1"
EVAL_API_KEY="<YOUR_EVAL_API_KEY>"

# Optional retry controls for a full public run.
ANSWER_MAX_RETRIES=4
ANSWER_TIMEOUT_SECONDS=600
EVAL_MAX_RETRIES=4
EVAL_TIMEOUT_SECONDS=600
